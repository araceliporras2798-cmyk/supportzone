      "item": [
        {
          "name": "Listar solicitudes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve una lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes"
              ]
            }
          }
        },
        {
          "name": "Filtrar por estado y prioridad",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes?estado=PENDIENTE&prioridad=MEDIA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "PENDIENTE"
                },
                {
                  "key": "prioridad",
                  "value": "MEDIA"
                }
              ]
            }
          }
        },
        {
          "name": "Registrar solicitud",
