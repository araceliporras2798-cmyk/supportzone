            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const s = pm.response.json();",
                  "pm.collectionVariables.set(\"solicitudId\", s.id);",
                  "pm.test(\"Queda PENDIENTE\", () => pm.expect(s.estado).to.eql(\"PENDIENTE\"));",
                  "pm.test(\"Header Location\", () => pm.response.to.have.header(\"Location\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
